# Architecture
BR2_arm=y

# Toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
# The ak3918ev300 family's toolchain: the same ARM926, musl and 4.4 headers
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/toolchain/toolchain.anyka-ak3918ev300.tgz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_4=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/$(OPENIPC_KERNEL).tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/ak3918av100x.generic.config"
# The generic AV100X kernel with this camera's device tree, and gpio-leds for
# its red and blue LEDs.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/ak3918av100x-baseus-s0tv022132.config"
# The uImage is the zImage with the board's DTB appended
# (CONFIG_ARM_APPENDED_DTB), built by the kernel itself as on hisilicon.
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_UIMAGE_LOADADDR="0x80008000"
BR2_LINUX_KERNEL_XZ=y

# Filesystem
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_ZLIB=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# OpenIPC
BR2_OPENIPC_SOC_VENDOR="anyka"
BR2_OPENIPC_SOC_MODEL="ak3918av100x"
BR2_OPENIPC_SOC_FAMILY="ak3918av100"
# AnyCloud39AV100 silicon (chip ID field 0x535335), 128 MB: the AK3918AV100X
# and AK3918AV100XP, and the KM01D.
BR2_OPENIPC_SOC_ALIASES="ak3918av100xp km01d"
BR2_OPENIPC_SNS_MODEL="sc5336"
BR2_OPENIPC_VARIANT="lite"
BR2_OPENIPC_FLASH_SIZE="8"

# Packages
# Video, audio, SD and USB host: the vendor's prebuilt modules (see the
# package's .mk); the SC5336 driver, which the SDK lacks, built from source.
BR2_PACKAGE_ANYKA_OSDRV_AK3918AV100=y
BR2_PACKAGE_ANYKA_OPENSDK_AK3918AV100=y
# Wi-Fi: an AIC8800D80 on USB (a69c:8d80), with the firmware from the
# driver's own tree. The generic image's other USB Wi-Fi drivers are left out.
BR2_PACKAGE_AIC8800_OPENIPC=y
BR2_PACKAGE_AIC8800_OPENIPC_FIRMWARE_D80=y
BR2_PACKAGE_DROPBEAR_OPENIPC=y
# The pan/tilt head: two 4-wire steppers on GPIO, pins in /etc/modules.
BR2_PACKAGE_GPIOSTEP_OPENIPC=y
BR2_PACKAGE_IPCTOOL=y
BR2_PACKAGE_LIBCURL_OPENIPC=y
BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
BR2_PACKAGE_LIBEVENT_OPENIPC=y
BR2_PACKAGE_LIBOGG_OPENIPC=y
BR2_PACKAGE_MAJESTIC=y
# The motor driver for majestic (ptz.actuator gpiostep), which also turns on
# the WebUI's pan/tilt controls.
BR2_PACKAGE_MAJESTIC_AF=y
BR2_PACKAGE_MAJESTIC_WEBUI=y
BR2_PACKAGE_MBEDTLS_OPENIPC=y
BR2_PACKAGE_OPUS_OPENIPC=y
BR2_PACKAGE_RESET_BUTTON=y
BR2_PACKAGE_VTUND_OPENIPC=y
BR2_PACKAGE_YAML_CLI=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_GENERAL_PATH)/scripts/post-image-split.sh"
