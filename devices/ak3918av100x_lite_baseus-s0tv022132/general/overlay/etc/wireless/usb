#!/bin/sh

# Baseus P1 Pro: an AIC8800D80 on USB, powered from GPIO 98, active low
# (wifi_install in the stock giec_sys_init.sh: high for 1 s, then low).
# The firmware and aic_fw_path come from aic8800-openipc's D80 option.
if [ "$1" = "aic8800-ak3918av100x-baseus-s0tv022132" ]; then
	gpio set 98 > /dev/null
	sleep 1
	gpio clear 98 > /dev/null
	modprobe aic8800 || exit 1
	# wlan0 appears once the dongle has re-enumerated with its firmware
	i=0
	while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e /sys/class/net/wlan0 ]
	exit $?
fi

exit 1
